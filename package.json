{
  "name": "noble-imprint-resource-website",
  "version": "1.0.0",
  "description": "Public website for Noble Imprint discipleship resources",
  "main": "src/server/index.js",
  "scripts": {
    "start": "node src/server/index.js",
    "dev": "node --watch src/server/index.js",
    "test:unit": "node --test \"tests/unit/*.test.js\"",
    "build:editor": "esbuild src/editor-entry.js --bundle --format=esm --outfile=src/public/js/codemirror-bundle.js",
    "build:reader": "esbuild src/reader-userdata-entry.js --bundle --format=esm --outfile=src/public/js/reader-userdata-bundle.js --minify"
  },
  "dependencies": {
    "@google-cloud/bigquery": "^9.0.3",
    "@google-cloud/storage": "^7.19.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "diff": "^8.0.4",
    "dotenv": "^17.4.2",
    "ejs": "^3.1.10",
    "express": "^4.21.0",
    "firebase-admin": "^13.8.0",
    "form-data": "^4.0.5",
    "geoip-country": "^5.0.202608252355",
    "js-yaml": "^4.1.0",
    "mailgun.js": "^13.0.0",
    "markdown-it": "^14.1.0",
    "markdown-it-footnote": "^4.0.0",
    "mjml": "^5.1.0",
    "octokit": "^4.1.0"
  },
  "devDependencies": {
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/state": "^6.6.0",
    "@noble-collective/userdata": "file:vendor/noble-collective-userdata-0.2.5.tgz",
    "@playwright/test": "^1.59.1",
    "codemirror": "^6.0.2",
    "esbuild": "^0.28.0",
    "firebase": "^11.7.1",
    "tributejs": "^5.1.3"
  }
}
