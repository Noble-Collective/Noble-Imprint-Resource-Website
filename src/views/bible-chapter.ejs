<%- include('partials/header') %>

  <aside class="sidebar">
    <a href="/bible/<%= translation.id %>" class="sidebar-back">&larr; <%= translation.title %></a>
    <div class="sidebar-sessions-title">Chapters</div>
    <ul class="nav-session-list">
      <% for (var ch = 1; ch <= totalChapters; ch++) { %>
        <li>
          <a href="/bible/<%= translation.id %>/<%= encodeURIComponent(bookName) %>?chapter=<%= ch %>" class="nav-session-item<%= ch === chapter ? ' active' : '' %>">
            <span class="session-num"><%= ch %></span>
            <span class="nav-session-name">Chapter <%= ch %></span>
          </a>
        </li>
      <% } %>
    </ul>
    <%- include('partials/sidebar-auth') %>
  </aside>

  <main class="main">
    <div class="reading-top">
      <div class="breadcrumb">
        <a href="/">Resources</a> <span>&rsaquo;</span>
        <a href="/bible">Bibles</a> <span>&rsaquo;</span>
        <a href="/bible/<%= translation.id %>"><%= translation.title %></a> <span>&rsaquo;</span>
        <a href="/bible/<%= translation.id %>/<%= encodeURIComponent(bookName) %>"><%= bookName %></a> <span>&rsaquo;</span>
        Chapter <%= chapter %>
      </div>
    </div>

    <% if (typeof audioSession !== 'undefined' && audioSession) { %>
      <!-- Floating audio icon — expands to player when playing -->
      <div class="audio-fab" id="audio-fab" data-book-path="<%= audioBookPath %>" data-audio-file="<%= audioSession.audioFile %>" data-timestamps-file="<%= audioSession.timestampsFile || '' %>" data-duration="<%= audioSession.durationSeconds || 0 %>" data-next-url="<%= chapter < totalChapters ? ('/bible/' + translation.id + '/' + encodeURIComponent(bookName) + '?chapter=' + (chapter + 1)) : '' %>">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 18v-6a9 9 0 0 1 18 0v6"/><path d="M21 19a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3zM3 19a2 2 0 0 0 2 2h1a2 2 0 0 0 2-2v-3a2 2 0 0 0-2-2H3z"/></svg>
      </div>
      <!-- Sticky bottom player bar (hidden until play) -->
      <div class="audio-player" id="audio-player" style="display:none">
        <div class="audio-player-main">
          <button class="audio-play-btn" id="audio-play-btn" aria-label="Play">
            <svg class="icon-play" width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><polygon points="5,3 19,12 5,21"/></svg>
            <svg class="icon-pause" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" style="display:none"><rect x="6" y="4" width="4" height="16"/><rect x="14" y="4" width="4" height="16"/></svg>
          </button>
          <span class="audio-time" id="audio-current-time">0:00</span>
          <input type="range" class="audio-scrubber" id="audio-scrubber" min="0" max="1000" value="0" step="1">
          <span class="audio-time" id="audio-duration"><%= audioFormatDuration(audioSession.durationSeconds) %></span>
          <button class="audio-expand-btn" id="audio-expand-btn" aria-label="More controls"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="18 15 12 9 6 15"/></svg></button>
        </div>
        <div class="audio-player-extra">
          <button class="audio-skip-btn" id="audio-skip-back" aria-label="Back 15s" title="Back 15s">-15s</button>
          <select class="audio-speed" id="audio-speed">
            <option value="0.75">0.75x</option>
            <option value="1" selected>1x</option>
            <option value="1.25">1.25x</option>
            <option value="1.5">1.5x</option>
          </select>
          <button class="audio-skip-btn" id="audio-skip-fwd" aria-label="Forward 15s" title="Forward 15s">+15s</button>
        </div>
        <button class="audio-close-btn" id="audio-close-btn" aria-label="Close player" title="Close player">&times;</button>
      </div>
    <% } %>

    <div class="reading-content">
      <div class="session-content bible-content">
        <h1><%= bookName %> <%= chapter %></h1>

        <% if (typeof audioBlocks !== 'undefined' && audioBlocks) { %>
          <%
            // Audio-enabled chapter: render from the converter's blocks so the DOM
            // (section headings + stanza paragraphs with <sup> verse numbers) matches
            // the audio timestamps the player syncs against.
            audioBlocks.forEach(function(b) {
              if (b.type === 'h2') { %><h3 class="bible-section-heading"><%= b.text %></h3><%
              } else if (b.type === 'h3') { %><h4 class="bible-section-heading"><%= b.text %></h4><%
              } else { %><p class="bible-paragraph"><%- b.text %></p><%
              }
            });
          %>
        <% } else { %>
          <%
            var inParagraph = false;
            verses.forEach(function(v, i) {
              if (v.sectionHeading) {
                if (inParagraph) { %></p><% inParagraph = false; }
                %><h3 class="bible-section-heading"><%= v.sectionHeading %></h3><%
              }
              if (v.paragraphStart || i === 0) {
                if (inParagraph) { %></p><% }
                %><p class="bible-paragraph"><% inParagraph = true;
              }
              %><span class="bible-verse" id="v<%= v.verse %>"><sup class="verse-num"><%= v.verse %></sup> <%= v.text %> </span><%
            });
            if (inParagraph) { %></p><% }
          %>
        <% } %>
      </div>

      <div class="session-nav">
        <% if (chapter > 1) { %>
          <a href="/bible/<%= translation.id %>/<%= encodeURIComponent(bookName) %>?chapter=<%= chapter - 1 %>" class="session-nav-link session-nav-prev">
            <span class="session-nav-dir">&larr; Previous</span>
            <span class="session-nav-name">Chapter <%= chapter - 1 %></span>
          </a>
        <% } else { %>
          <div class="session-nav-link session-nav-placeholder"></div>
        <% } %>
        <% if (chapter < totalChapters) { %>
          <a href="/bible/<%= translation.id %>/<%= encodeURIComponent(bookName) %>?chapter=<%= chapter + 1 %>" class="session-nav-link session-nav-next">
            <span class="session-nav-dir">Next &rarr;</span>
            <span class="session-nav-name">Chapter <%= chapter + 1 %></span>
          </a>
        <% } else { %>
          <div class="session-nav-link session-nav-placeholder"></div>
        <% } %>
      </div>
    </div>
  </main>

<% if (typeof audioSession !== 'undefined' && audioSession) { %>
<script src="/static/js/audio-player.js?v=27"></script>
<% } %>

<%- include('partials/footer') %>
