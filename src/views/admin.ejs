<%- include('partials/header') %>

  <main class="admin-main">
    <a href="/" class="admin-back">&larr; Back to Resources</a>
    <h1 class="admin-page-title">Admin Console</h1>

    <div class="admin-tabs">
      <button class="admin-tab admin-tab--active" data-admin-tab="users">Users</button>
      <button class="admin-tab" data-admin-tab="books">Books</button>
      <button class="admin-tab" data-admin-tab="reviews">Reviews<% if (typeof pendingSuggestionCount !== 'undefined' && pendingSuggestionCount > 0) { %> <span class="admin-tab-badge"><%= pendingSuggestionCount %></span><% } %></button>
      <button class="admin-tab" data-admin-tab="diff-reports">Diff Reports</button>
      <button class="admin-tab" data-admin-tab="analytics">Analytics</button>
      <button class="admin-tab" data-admin-tab="bible-validation">Bible Validation</button>
    </div>

    <!-- ===== USERS TAB ===== -->
    <div class="admin-panel" id="panel-users">
      <div class="admin-toolbar">
        <button class="admin-btn admin-btn--primary" id="add-user-btn">+ Add User</button>
      </div>

      <div class="admin-table-wrap">
        <table class="admin-table" id="users-table">
          <thead>
            <tr>
              <th>User</th>
              <th>Email</th>
              <th>Global Role</th>
              <th>Book Roles</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            <%
              function summarizeBookRoles(bookRoles) {
                if (!bookRoles) return [];
                var counts = {};
                var labels = { 'viewer': 'Viewer', 'comment-suggest': 'Commenter', 'manuscript-owner': 'Manuscript Owner' };
                Object.values(bookRoles).forEach(function(role) {
                  var label = labels[role] || role;
                  counts[label] = (counts[label] || 0) + 1;
                });
                return Object.keys(counts).map(function(label) {
                  return label + ' for ' + counts[label] + ' book' + (counts[label] === 1 ? '' : 's');
                });
              }
            %>
            <% users.forEach(function(u) { %>
              <tr data-user-email="<%= u.email %>">
                <td class="admin-user-cell">
                  <% if (u.photoURL) { %>
                    <img src="<%= u.photoURL %>" alt="" class="admin-avatar" referrerpolicy="no-referrer">
                  <% } else { %>
                    <span class="admin-avatar admin-avatar--initials"><%= (u.displayName || u.email)[0].toUpperCase() %></span>
                  <% } %>
                  <span><%= u.displayName || u.email %></span>
                </td>
                <td><%= u.email %></td>
                <td>
                  <% if (u.isSuperAdmin) { %>
                    <span class="admin-badge admin-badge--super">Super Admin</span>
                  <% } else if (u.globalRole === 'admin') { %>
                    <span class="admin-badge admin-badge--admin">Admin</span>
                    <button class="admin-btn-inline" data-edit-user="<%= u.email %>" data-role="<%= u.globalRole || '' %>">Edit</button>
                  <% } else { %>
                    <span class="admin-badge admin-badge--none">None</span>
                    <button class="admin-btn-inline" data-edit-user="<%= u.email %>" data-role="<%= u.globalRole || '' %>">Edit</button>
                  <% } %>
                </td>
                <td>
                  <% var summary = summarizeBookRoles(u.bookRoles); %>
                  <% if (u.isAdmin) { %>
                    <span class="text-muted">All books (admin)</span>
                  <% } else if (summary.length > 0) { %>
                    <% summary.forEach(function(line) { %>
                      <span class="admin-role-summary"><%= line %></span>
                    <% }); %>
                    <button class="admin-btn-inline" data-show-book-roles="<%= u.email %>"
                      data-is-admin="false" data-is-super="false">Edit</button>
                  <% } else { %>
                    <span class="text-muted">None</span>
                    <button class="admin-btn-inline" data-show-book-roles="<%= u.email %>"
                      data-is-admin="false" data-is-super="false">Edit</button>
                  <% } %>
                </td>
                <td class="admin-actions-cell">
                  <% if (!u.isSuperAdmin) { %>
                    <button class="admin-btn admin-btn--sm admin-btn--danger" data-delete-user="<%= u.email %>">Remove User</button>
                  <% } %>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </div>

    <!-- ===== BOOKS TAB ===== -->
    <div class="admin-panel admin-panel--hidden" id="panel-books">
      <div class="admin-table-wrap">
        <table class="admin-table" id="books-table">
          <thead>
            <tr>
              <th>Book</th>
              <th>Series</th>
              <th>Banner</th>
              <th>Status</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% books.forEach(function(book) { %>
              <tr data-book-path="<%= book.repoPath %>">
                <td class="admin-book-cell">
                  <% if (book.coverPath) { %>
                    <div class="admin-book-thumb"><img src="/cover/<%= book.coverPath %>" alt=""></div>
                  <% } %>
                  <span><%= book.title %></span>
                </td>
                <td>
                  <%= book.seriesTitle %>
                  <% if (book.subseriesTitle) { %><span class="text-muted"> / <%= book.subseriesTitle %></span><% } %>
                </td>
                <td>
                  <% if (book.banner && book.banner !== 'Hidden') { %>
                    <span class="admin-badge admin-badge--banner"><%= book.banner %></span>
                  <% } else { %>
                    <span class="text-muted">--</span>
                  <% } %>
                </td>
                <td>
                  <label class="admin-toggle" title="Toggle visibility">
                    <input type="checkbox"
                      class="admin-toggle-input"
                      data-toggle-status="<%= book.repoPath %>"
                      <%= book.status === 'public' ? 'checked' : '' %>>
                    <span class="admin-toggle-slider"></span>
                    <span class="admin-toggle-label"><%= book.status === 'public' ? 'Public' : 'Hidden' %></span>
                  </label>
                </td>
                <td>
                  <button class="admin-btn admin-btn--sm" data-manage-access="<%= book.repoPath %>" data-book-title="<%= book.title %>">Manage Access</button>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </div>

    <!-- ===== REVIEWS TAB ===== -->
    <div class="admin-panel admin-panel--hidden" id="panel-reviews">
      <p class="text-muted" style="margin-bottom:16px">Files with pending suggestions. Click to review inline.</p>
      <div id="reviews-list">
        <p class="text-muted">Loading...</p>
      </div>
    </div>

    <!-- ===== DIFF REPORTS PANEL ===== -->
    <div class="admin-panel admin-panel--hidden" id="panel-diff-reports">
      <p class="text-muted" style="margin-bottom:16px">Compare a book's content between two points in time.</p>
      <div class="admin-diff-controls">
        <div class="admin-diff-row">
          <label class="admin-label">Book</label>
          <select class="admin-select" id="diff-book-select">
            <option value="">Select a book...</option>
            <% books.forEach(function(book) { %>
              <option value="<%= book.repoPath %>"><%= book.title %><%= book.seriesTitle ? ' (' + book.seriesTitle + ')' : '' %></option>
            <% }); %>
          </select>
        </div>
        <div class="admin-diff-row">
          <label class="admin-label">From (older)</label>
          <select class="admin-select" id="diff-from-select" disabled>
            <option value="">Select a tag...</option>
          </select>
          <input type="file" id="diff-file-upload" accept=".md,.txt,.markdown" style="display:none">
          <div id="diff-file-name" class="text-muted" style="display:none; font-size:12px; margin-top:2px;"></div>
        </div>
        <div class="admin-diff-row">
          <label class="admin-label">To (newer)</label>
          <select class="admin-select" id="diff-to-select">
            <option value="main">main (latest)</option>
          </select>
        </div>
        <button class="admin-btn admin-btn--primary" id="diff-generate-btn" disabled>Generate Report</button>
      </div>
      <div id="diff-report-output"></div>
    </div>

    <!-- ===== BIBLE VALIDATION PANEL ===== -->
    <div class="admin-panel admin-panel--hidden" id="panel-bible-validation">
      <div class="bv-subtabs">
        <button class="bv-subtab bv-subtab--active" data-bv-sub="compare">Compare to BSB</button>
        <button class="bv-subtab" data-bv-sub="audit">Quotation Audit</button>
        <button class="bv-subtab" data-bv-sub="version">Version &amp; History</button>
      </div>

      <!-- Sub-tab: Compare to BSB -->
      <section class="bv-sub" id="bv-sub-compare">
        <p class="text-muted bv-lede">
          Independently compare our stored Bible against the live official text at
          <strong>bereanbible.com</strong>, book by book. This is a deterministic check — not AI —
          that walks every book and reports exactly what differs. Read-only: nothing changes until
          you Accept a specific difference below.
        </p>
        <div class="bv-toolbar">
          <label class="admin-label">Translation</label>
          <select class="admin-select" id="bv-translation-select">
            <option value="bsb">Berean Standard Bible (BSB)</option>
          </select>
          <button class="admin-btn admin-btn--primary" id="bv-compare-btn">Compare to current BSB</button>
        </div>
        <div id="bv-checklist"></div>
        <div id="bv-compare-output"></div>
      </section>

      <!-- Sub-tab: Quotation Audit -->
      <section class="bv-sub bv-sub--hidden" id="bv-sub-audit">
        <p class="text-muted bv-lede">
          Compare every Scripture quotation in the library against our current Bible text.
          Cosmetic differences (e.g. &ldquo;Lord&rdquo; vs &ldquo;LORD&rdquo;) are counted but set
          aside; genuine wording differences are grouped for review.
        </p>
        <button class="admin-btn admin-btn--primary" id="qa-run-btn">Run Quotation Audit</button>
        <div id="qa-output"></div>
      </section>

      <!-- Sub-tab: Version & History -->
      <section class="bv-sub bv-sub--hidden" id="bv-sub-version">
        <div id="bv-version"><p class="text-muted">Loading version&hellip;</p></div>
        <h3 style="margin-top:24px">Run History</h3>
        <div id="bv-history"><p class="text-muted">Loading history&hellip;</p></div>
      </section>
    </div>

    <!-- ===== ANALYTICS TAB ===== -->
    <div class="admin-panel admin-panel--hidden" id="panel-analytics">
      <div class="an-controls">
        <div class="an-range" role="group" aria-label="Date range">
          <button class="an-range-btn" data-range="7d">7d</button>
          <button class="an-range-btn an-range-btn--active" data-range="30d">30d</button>
          <button class="an-range-btn" data-range="90d">90d</button>
          <button class="an-range-btn" data-range="365d">1y</button>
          <button class="an-range-btn" data-range="all">All</button>
        </div>
        <select class="admin-select an-book-select" id="an-book" aria-label="Filter by book">
          <option value="">All content</option>
          <% books.forEach(function(book) { %>
            <option value="<%= book.title %>"><%= book.title %><%= book.seriesTitle ? ' — ' + book.seriesTitle : '' %></option>
          <% }); %>
        </select>
        <label class="an-bots"><input type="checkbox" id="an-include-bots"> Include bots</label>
        <span class="an-status text-muted" id="an-status"></span>
      </div>

      <div class="an-subtabs" role="tablist">
        <button class="an-subtab an-subtab--active" data-an-sub="resource">Resource Analytics</button>
        <button class="an-subtab" data-an-sub="basic">Basic Analytics</button>
      </div>

      <div class="an-sub" id="an-sub-resource">
      <h2 class="an-scope-title" id="an-scope-title" style="display:none"></h2>
      <div class="an-tiles" id="an-tiles"></div>

      <div class="an-card an-card--wide" id="an-card-leaderboard">
        <h3 class="an-card-title">Book leaderboard <span class="an-card-sub">click a column to sort · click a row to drill in</span></h3>
        <div class="an-table-box" id="an-leaderboard"></div>
      </div>

      <div class="an-grid">
        <div class="an-card" id="an-card-scatter">
          <h3 class="an-card-title">Reach vs engagement <span class="an-card-sub">readers × avg time on page; bubble = pageviews</span></h3>
          <div class="an-chart-box"><canvas id="an-scatter"></canvas></div>
        </div>
        <div class="an-card" id="an-card-momentum">
          <h3 class="an-card-title">Momentum <span class="an-card-sub">pageviews over time, top books</span></h3>
          <div class="an-chart-box"><canvas id="an-multitrend"></canvas></div>
        </div>
      </div>

      <div class="an-grid">
        <div class="an-card" id="an-card-books">
          <h3 class="an-card-title">Books <span class="an-card-sub">pageviews per book</span></h3>
          <div class="an-chart-box"><canvas id="an-books"></canvas></div>
        </div>
        <div class="an-card" id="an-card-bible">
          <h3 class="an-card-title">Top Bible chapters</h3>
          <div class="an-chart-box"><canvas id="an-bible"></canvas></div>
        </div>
      </div>

      <div class="an-card an-card--wide">
        <h3 class="an-card-title" id="an-sessions-title">Top sessions</h3>
        <div class="an-table-box" id="an-sessions"></div>
      </div>

      <div class="an-card">
        <h3 class="an-card-title">Audio listening</h3>
        <div class="an-tiles an-tiles--audio" id="an-audio-tiles"></div>
        <h4 class="an-subhead">Most-engaged sessions <span class="an-card-sub">avg time on page</span></h4>
        <div class="an-table-box" id="an-dwell"></div>
      </div>

      <div class="an-card an-card--wide" id="an-card-funnel" style="display:none">
        <h3 class="an-card-title">Session drop-off <span class="an-card-sub">unique readers who reached each session</span></h3>
        <div class="an-table-box" id="an-funnel"></div>
      </div>

      <div class="an-card" id="an-card-split">
        <h3 class="an-card-title">Bible vs Books</h3>
        <div class="an-chart-box an-chart-box--sm"><canvas id="an-split"></canvas></div>
      </div>
      </div><!-- /an-sub-resource -->

      <div class="an-sub an-sub--hidden" id="an-sub-basic">
        <div class="an-card an-card--wide">
          <h3 class="an-card-title">Traffic <span class="an-card-sub">pageviews &amp; unique visitors per day</span></h3>
          <div class="an-chart-box"><canvas id="an-trend"></canvas></div>
        </div>
        <div class="an-grid">
          <div class="an-card">
            <h3 class="an-card-title">Devices</h3>
            <div class="an-chart-box an-chart-box--sm"><canvas id="an-devices"></canvas></div>
          </div>
          <div class="an-card">
            <h3 class="an-card-title">Browsers</h3>
            <div class="an-chart-box an-chart-box--sm"><canvas id="an-browsers"></canvas></div>
          </div>
        </div>
        <div class="an-grid">
          <div class="an-card">
            <h3 class="an-card-title">Operating systems</h3>
            <div class="an-chart-box an-chart-box--sm"><canvas id="an-os"></canvas></div>
          </div>
          <div class="an-card">
            <h3 class="an-card-title">Top countries <span class="an-card-sub">by unique visitors</span></h3>
            <div class="an-table-box" id="an-countries"></div>
          </div>
        </div>
        <div class="an-card an-card--wide">
          <h3 class="an-card-title">Top referrers</h3>
          <div class="an-table-box" id="an-referrers"></div>
        </div>
      </div><!-- /an-sub-basic -->
    </div>

    <!-- ===== MODALS ===== -->

    <!-- Add User Modal -->
    <div class="admin-modal-overlay" id="modal-add-user" style="display:none">
      <div class="admin-modal">
        <div class="admin-modal-header">
          <h2>Add User</h2>
          <button class="admin-modal-close" data-close-modal>&times;</button>
        </div>
        <div class="admin-modal-body">
          <label class="admin-label">Email Address</label>
          <input type="email" class="admin-input" id="add-user-email" placeholder="user@example.com">
        </div>
        <div class="admin-modal-footer">
          <button class="admin-btn" data-close-modal>Cancel</button>
          <button class="admin-btn admin-btn--primary" id="add-user-submit">Add User</button>
        </div>
      </div>
    </div>

    <!-- Edit User Modal -->
    <div class="admin-modal-overlay" id="modal-edit-user" style="display:none">
      <div class="admin-modal">
        <div class="admin-modal-header">
          <h2>Edit User</h2>
          <button class="admin-modal-close" data-close-modal>&times;</button>
        </div>
        <div class="admin-modal-body">
          <p class="admin-modal-subtitle" id="edit-user-email"></p>
          <label class="admin-label">Global Role</label>
          <select class="admin-select" id="edit-user-role">
            <option value="">No global role</option>
            <option value="admin">Admin</option>
          </select>
        </div>
        <div class="admin-modal-footer">
          <button class="admin-btn" data-close-modal>Cancel</button>
          <button class="admin-btn admin-btn--primary" id="edit-user-submit">Save</button>
        </div>
      </div>
    </div>

    <!-- Manage Book Access Modal -->
    <div class="admin-modal-overlay" id="modal-manage-access" style="display:none">
      <div class="admin-modal admin-modal--wide">
        <div class="admin-modal-header">
          <h2>Manage Access: <span id="access-book-title"></span></h2>
          <button class="admin-modal-close" data-close-modal>&times;</button>
        </div>
        <div class="admin-modal-body">
          <div class="admin-access-add">
            <select class="admin-select" id="access-user-select">
              <option value="">Select a user...</option>
              <% users.forEach(function(u) { %>
                <% if (!u.isSuperAdmin) { %>
                  <option value="<%= u.email %>"><%= u.displayName || u.email %></option>
                <% } %>
              <% }); %>
            </select>
            <select class="admin-select" id="access-role-select">
              <option value="viewer">Viewer</option>
              <option value="comment-suggest">Comment / Suggest</option>
              <option value="manuscript-owner">Manuscript Owner</option>
            </select>
            <button class="admin-btn admin-btn--primary admin-btn--sm" id="access-add-btn">Add</button>
          </div>
          <div id="access-list" class="admin-access-list">
            <p class="text-muted">Loading...</p>
          </div>
        </div>
        <div class="admin-modal-footer">
          <button class="admin-btn" data-close-modal>Done</button>
        </div>
      </div>
    </div>

    <!-- Book Roles for User Modal -->
    <div class="admin-modal-overlay" id="modal-book-roles" style="display:none">
      <div class="admin-modal admin-modal--wide">
        <div class="admin-modal-header">
          <h2>Book Roles: <span id="book-roles-user-email"></span></h2>
          <button class="admin-modal-close" data-close-modal>&times;</button>
        </div>
        <div class="admin-modal-body">
          <div id="book-roles-list" class="admin-access-list">
            <p class="text-muted">Loading...</p>
          </div>
        </div>
        <div class="admin-modal-footer">
          <button class="admin-btn" data-close-modal>Done</button>
        </div>
      </div>
    </div>

  </main>
<script>
  // Pass server data to client JS (safe serialization)
  window.__ADMIN_DATA = JSON.parse('<%- JSON.stringify({
    users: users.map(function(u) {
      return { email: u.email, displayName: u.displayName, isSuperAdmin: u.isSuperAdmin, globalRole: u.globalRole, bookRoles: u.bookRoles || {} };
    }),
    books: books.map(function(b) {
      return { repoPath: b.repoPath, title: b.title, status: b.status, seriesTitle: b.seriesTitle || '' };
    }),
  }).replace(/\\/g, "\\\\").replace(/'/g, "\\'").replace(/</g, "\\u003c") %>');
</script>
<script src="/static/js/admin.js?v=12"></script>
<script src="/static/js/vendor/chart.umd.js?v=1"></script>
<script src="/static/js/admin-analytics.js?v=4"></script>

<%- include('partials/footer') %>
