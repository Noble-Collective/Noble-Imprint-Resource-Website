<%- include('partials/header') %>

  <!-- ===== SIDEBAR: Session Navigation ===== -->
  <aside class="sidebar">
    <%- include('partials/session-sidebar') %>
  </aside>

  <!-- ===== MOBILE TOC BAR ===== -->
  <div class="mobile-toc-bar" data-mobile-toc>
    <button class="mobile-toc-toggle" data-mobile-toc-toggle>
      <span class="mobile-toc-label"><%= session.title || session.displayName %></span>
      <svg class="mobile-toc-chevron" width="10" height="6" viewBox="0 0 10 6" fill="none"><path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </button>
    <div class="mobile-toc-panel" data-mobile-toc-panel></div>
  </div>

  <!-- ===== MAIN CONTENT ===== -->
  <main class="main" data-book-url="<%= content.bookUrl(series, subseries, book) %>">
    <div class="reading-top">
      <div class="breadcrumb">
        <%- include('partials/session-breadcrumb') %>
      </div>
    </div>

    <%- include('partials/session-edit-toolbar') %>

    <% if (typeof audioSession !== 'undefined' && audioSession) { %>
      <!-- Floating audio icon — expands to player when playing -->
      <div class="audio-fab" id="audio-fab" data-book-path="<%= book.repoPath.replace(/^series\//, '') %>" data-audio-file="<%= audioSession.audioFile %>" data-timestamps-file="<%= audioSession.timestampsFile || '' %>" data-duration="<%= audioSession.durationSeconds || 0 %>" data-next-url="<%= nextSession ? content.sessionUrl(series, subseries, book, nextSession) : '' %>">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 18v-6a9 9 0 0 1 18 0v6"/><path d="M21 19a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3zM3 19a2 2 0 0 0 2 2h1a2 2 0 0 0 2-2v-3a2 2 0 0 0-2-2H3z"/></svg>
      </div>
      <!-- Sticky bottom player bar (hidden until play) -->
      <div class="audio-player" id="audio-player" style="display:none">
        <div class="audio-player-main">
          <button class="audio-play-btn" id="audio-play-btn" aria-label="Play">
            <svg class="icon-play" width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><polygon points="5,3 19,12 5,21"/></svg>
            <svg class="icon-pause" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" style="display:none"><rect x="6" y="4" width="4" height="16"/><rect x="14" y="4" width="4" height="16"/></svg>
          </button>
          <span class="audio-time" id="audio-current-time">0:00</span>
          <input type="range" class="audio-scrubber" id="audio-scrubber" min="0" max="1000" value="0" step="1">
          <span class="audio-time" id="audio-duration"><%= audioFormatDuration(audioSession.durationSeconds) %></span>
          <button class="audio-expand-btn" id="audio-expand-btn" aria-label="More controls"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="18 15 12 9 6 15"/></svg></button>
        </div>
        <div class="audio-player-extra">
          <button class="audio-skip-btn" id="audio-skip-back" aria-label="Back 15s" title="Back 15s">-15s</button>
          <select class="audio-speed" id="audio-speed">
            <option value="0.75">0.75x</option>
            <option value="1" selected>1x</option>
            <option value="1.25">1.25x</option>
            <option value="1.5">1.5x</option>
          </select>
          <button class="audio-skip-btn" id="audio-skip-fwd" aria-label="Forward 15s" title="Forward 15s">+15s</button>
        </div>
        <button class="audio-close-btn" id="audio-close-btn" aria-label="Close player" title="Close player">&times;</button>
      </div>
    <% } %>

    <div class="reading-content" id="reading-content">
      <div class="session-content<%= book.accent ? ' accent-themed' : '' %>"<% if (book.accent) { %> style="--accent: <%= book.accent %>"<% } %>>
        <%- sessionHtml %>
      </div>

      <div class="session-nav">
        <%- include('partials/session-nav') %>
      </div>
    </div>

    <script>
    // Infographic dot spacing: enforce a minimum gap between consecutive spine
    // dots (= 1.5× the first gap), pushing DOWN only the ones that are too close
    // and leaving every other dot at its natural position. Two-column (wide) only.
    (function () {
      function fixDots() {
        var wide = window.innerWidth >= 680;
        document.querySelectorAll('.infographic .info-items').forEach(function (ul) {
          var items = Array.prototype.slice.call(ul.querySelectorAll('.info-item'));
          items.forEach(function (it) { it.style.marginTop = ''; }); // reset to CSS defaults
          if (!wide || items.length < 3) return;
          var top = function (it) { return it.getBoundingClientRect().top; };
          var firstGap = top(items[1]) - top(items[0]);
          if (firstGap <= 0) return;
          var MIN = firstGap * 1.5;
          for (var i = 1; i < items.length; i++) {
            var gap = top(items[i]) - top(items[i - 1]);
            if (gap < MIN) {
              var cur = parseFloat(getComputedStyle(items[i]).marginTop) || 0;
              items[i].style.marginTop = (cur + (MIN - gap)) + 'px';
            }
          }
        });
      }
      var raf = function () { requestAnimationFrame(fixDots); };
      window.addEventListener('load', raf);
      window.addEventListener('resize', raf);
      if (document.fonts && document.fonts.ready) document.fonts.ready.then(raf);
      document.addEventListener('DOMContentLoaded', raf);
    })();
    </script>

    <% if (typeof editRole !== 'undefined' && editRole) { %>
    <!-- Editor container (hidden until edit mode) -->
    <div class="editor-container" id="editor-container" style="display:none">
      <div class="editor-nav">
        <a href="<%= content.bookUrl(series, subseries, book) %>" class="editor-nav-link">&larr; <%= book.title %></a>
        <span class="editor-nav-sep">/</span>
        <span class="editor-nav-current"><%= session.title || session.displayName %></span>
      </div>
      <div class="editor-toolbar" id="editor-toolbar-bar">
        <div class="editor-toolbar-left">
          <span class="editor-mode-label" id="editor-mode-label">Suggesting Edits</span>
          <span class="editor-save-status" id="editor-save-status"></span>
          <div class="editor-toolbar-sep"></div>
          <div class="editor-search-group">
            <input type="text" class="editor-search-input" id="editor-search-input" placeholder="Find..." title="Search text (Enter = next, Shift+Enter = previous)">
            <button class="edit-btn edit-btn--tool" id="btn-search-prev" title="Previous match">&#9650;</button>
            <button class="edit-btn edit-btn--tool" id="btn-search-next" title="Next match">&#9660;</button>
            <button class="edit-btn edit-btn--tool" id="btn-search-clear" title="Clear search">&#10005;</button>
            <span class="editor-search-count" id="editor-search-count"></span>
          </div>
        </div>
        <div class="editor-presence" id="editor-presence"></div>
        <div class="editor-history-toggle">
          <button class="edit-btn edit-btn--tool editor-history-btn active" id="btn-margin-active" title="Active suggestions">Active</button>
          <button class="edit-btn edit-btn--tool editor-history-btn" id="btn-margin-history" title="Resolved history">History</button>
        </div>
        <div class="editor-toolbar-right">
          <label class="editor-toggle" title="Show line numbers">
            <input type="checkbox" id="chk-line-numbers" checked>
            <span>Lines</span>
          </label>
          <button class="edit-btn edit-btn--source" id="btn-view-source" title="Toggle raw markdown view">&lt;/&gt; Source</button>
          <div class="editor-toolbar-sep"></div>
          <button class="edit-btn edit-btn--tool" id="btn-prev-card" title="Previous suggestion or comment">&#9664; Prev Edit</button>
          <button class="edit-btn edit-btn--tool" id="btn-next-card" title="Next suggestion or comment">Next Edit &#9654;</button>
          <button class="edit-btn edit-btn--primary" id="btn-editor-done">Done</button>
        </div>
      </div>
      <div class="direct-edit-lock-banner" id="direct-edit-lock-banner" style="display:none"></div>
      <div class="editor-stale-banner" id="editor-stale-banner" style="display:none">
        <span class="stale-banner-icon">&#9888;</span>
        <span class="stale-banner-text" id="stale-banner-text"></span>
        <button class="stale-banner-btn" id="stale-banner-reload">Reload latest version</button>
        <button class="stale-banner-dismiss" id="stale-banner-dismiss" title="Dismiss">&times;</button>
      </div>
      <!-- Shared-file edit banner (shown when editing a common file directly via ?editFile) -->
      <% if (typeof editingSharedFile !== 'undefined' && editingSharedFile) { %>
      <div class="editor-sharedfile-banner" id="editor-sharedfile-banner">
        <span class="shared-banner-icon">&#128279;</span>
        <span class="shared-banner-text">Editing shared file <strong><%= editingSharedFile.path.split('/').pop() %></strong> — changes affect every session that includes it</span>
        <a class="shared-banner-back" href="<%= editingSharedFile.backUrl %>">&larr; Back to session</a>
      </div>
      <% } %>
      <div class="editor-body">
        <div id="codemirror-host"></div>
        <div class="editor-refresh-overlay" id="editor-refresh-overlay" style="display:none">
          <span class="margin-card-spinner"></span>
          <span>Refreshing from GitHub...</span>
        </div>
        <div class="suggestion-margin" id="suggestion-margin">
          <div class="margin-empty">No changes yet</div>
        </div>
      </div>
      <!-- Floating comment popup (appears near selected text) -->
      <div class="comment-popup" id="comment-popup" style="display:none">
        <textarea class="comment-popup-input" id="comment-popup-input" placeholder="Add a comment..." rows="3"></textarea>
        <div class="comment-popup-actions">
          <button class="edit-btn" id="comment-popup-cancel">Cancel</button>
          <button class="edit-btn edit-btn--primary" id="comment-popup-submit">Comment</button>
        </div>
      </div>
      <!-- Toast notifications -->
      <div class="editor-toast" id="editor-toast" style="display:none"></div>
      <!-- Commit message modal -->
      <div class="editor-modal-overlay" id="commit-modal" style="display:none">
        <div class="editor-modal">
          <div class="editor-modal-header">
            <h3>Commit Changes</h3>
          </div>
          <div class="editor-modal-body">
            <label for="commit-message" class="editor-modal-label">Describe your changes (optional)</label>
            <textarea id="commit-message" class="editor-modal-textarea" rows="3" placeholder="e.g. Fixed grammar in introduction paragraph"></textarea>
          </div>
          <div class="editor-modal-footer">
            <button class="edit-btn" id="commit-cancel">Cancel</button>
            <button class="edit-btn edit-btn--primary" id="commit-confirm">Commit</button>
          </div>
        </div>
      </div>
    </div>
    <% } %>

    <!-- Full-page loading overlay (shown during reload after exiting editor) -->
    <div class="page-reload-overlay" id="page-reload-overlay" style="display:none">
      <span class="margin-card-spinner" style="width:20px;height:20px"></span>
      <span>Loading latest content...</span>
    </div>

  </main>

<% if (typeof editRole !== 'undefined' && editRole) { %>
    <script>
      window.__EDITOR_DATA = JSON.parse('<%- JSON.stringify({
        rawContent: rawContent,
        contentSha: contentSha,
        editRole: editRole,
        sessionFilePath: sessionFilePath,
        bookRepoPath: bookRepoPath,
        resolvedContent: (typeof resolvedContent !== 'undefined') ? resolvedContent : null,
        segments: (typeof segments !== 'undefined') ? segments : null,
        editorFiles: (typeof editorFiles !== 'undefined') ? editorFiles : null,
        editingSharedFile: (typeof editingSharedFile !== 'undefined') ? editingSharedFile : null,
        pendingSuggestions: pendingSuggestions || [],
        pendingComments: pendingComments || [],
        pendingReplies: pendingReplies || [],
        canReview: canReview || false,
        user: user ? { email: user.email, displayName: user.displayName, photoURL: user.photoURL } : null,
      }).replace(/\\/g, "\\\\").replace(/\n/g, "\\n").replace(/\r/g, "\\r").replace(/'/g, "\\'").replace(/</g, "\\u003c") %>');
    </script>
    <script type="module" src="/static/js/editor.js?v=7"></script>
<% } %>

<% if (typeof audioSession !== 'undefined' && audioSession) { %>
<script src="/static/js/audio-player.js?v=27"></script>
<% } %>

<script src="/static/js/ajax-nav.js?v=1"></script>

<% if (typeof featureUserData !== 'undefined' && featureUserData && typeof readerContext !== 'undefined' && readerContext) { %>
<!-- Convergence per-user data layer (answers/bookmarks). Additive, gated, self-contained bundle. -->
<script>window.__READER_CTX = JSON.parse('<%- JSON.stringify(readerContext).replace(/\\/g, "\\\\").replace(/'/g, "\\'").replace(/</g, "\\u003c") %>');</script>
<script type="module" src="/static/js/reader-userdata-bundle.js?v=4"></script>
<% } %>

<%- include('partials/footer') %>
